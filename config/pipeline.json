    "GDP_PPP_per_capita":        "currency",
    "GDP_PPP_rank":              "number",
    "GDP_nominal":               "currency",
    "GDP_nominal_year":          "year",
    "GDP_nominal_per_capita":    "currency",
    "GDP_nominal_rank":          "number",
    "Gini":                      "number",
    "Gini_year":                 "year",
    "Gini_change":               "text",
    "HDI":                       "number",
    "HDI_year":                  "year",
    "HDI_rank":                  "number",
    "HDI_change":                "text",
    "area_rank":                 "number",
    "coordinates":               "coordinates",
    "religion":                  "distribution:religion",
    "ethnic_groups":             "distribution:ethnicity",
    "official_languages":        "distribution:language",
    "languages":                 "distribution:language",
    "government_type":           "wikilink",
    "capital":                   "wikilink",
    "largest_city":              "wikilink",
    "legislature":               "wikilink",
    "currency":                  "wikilink",
    "national_motto":            "text",
    "national_anthem":           "text",
    "demonym":                   "wikilink",
    "drives_on":                 "text",
    "timezone":                  "text",
    "utc_offset":                "text",
    "iso3166code":               "text",
    "cctld":                     "text",
    "calling_code":              "text"
  },

  "_comment_field_weights": "Multiplier applied to insert/delete/relabel costs for any node within this field path. Default = 1.0.",
  "field_weights": {
    "default":                          1.0,
    "identity.long_name":               0.5,
    "identity.common_name":             0.3,
    "identity.native_name":             0.3,
    "identity.motto":                   0.5,
    "identity.anthem":                  0.5,
    "identity.demonym":                 0.5,
    "geography.capital":                2.0,
    "geography.largest_city":           0.8,
    "geography.coordinates":            1.0,
    "geography.area":                   1.2,
    "geography.timezone":               0.5,
    "geography.utc_offset":             0.3,
    "geography.drives_on":              0.3,
    "government.type":                  2.5,
    "government.legislature":           1.2,
    "government.leaders":               1.0,
    "economy.gdp_ppp":                  1.8,
    "economy.gdp_nominal":              1.5,
    "economy.hdi":                      1.5,
    "economy.gini":                     1.0,
    "economy.currency":                 0.8,
    "demographics.population":          1.5,
    "demographics.languages":           1.5,
    "demographics.religion":            1.8,
    "demographics.ethnic_groups":       1.5,
    "history.established":              0.7,
    "codes":                            0.3
  },

  "_comment_subtree_similarity": "Controls Nierman & Jagadish's subtree-containment rule. When enabled, inserting (or deleting) a subtree that already exists in the other tree costs a single base op times the field weight, instead of the per-node sum. Set 'enabled' to false to revert to summing per-node costs (classic Selkow-style alignment).",
  "subtree_similarity": {
    "enabled":          true,
    "move_cost_factor": 1.0
  },

  "_comment_ted_costs": "Multiple named cost models. The UI picks one per comparison. 'default' names the model used when none is specified.",
  "ted_costs": {
    "default": "symmetric",
    "models": {
      "symmetric": {
        "insert":                1.0,
        "delete":                1.0,
        "type_mismatch_relabel": 1.0,
        "missing_vs_present":    1.0
      },
      "asymmetric": {
        "insert":                1.0,
        "delete":                2.0,
        "type_mismatch_relabel": 1.0,
        "missing_vs_present":    1.0
      }
    },
    "scales": {
      "number_min_denom":              1e-9,
      "year_full_distance":            100,
      "date_full_distance_years":      100,
      "coordinates_full_distance_km":  20000,
      "currency_full_distance_usd_log10": 4
    },
    "text_distance": "normalized_levenshtein",
    "list_distance": "emd"
  },


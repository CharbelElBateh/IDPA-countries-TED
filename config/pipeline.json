{
  "version": "2.0",
  "description": "Single source of truth for the IDPA country-comparison pipeline. Drives field cleaning, alias resolution, tree construction, typed parsing, distance functions, TED costs, currency normalization, and taxonomies.",

  "_comment_field_aliases": "Map variant Wikipedia infobox key names to a single canonical key.",
  "field_aliases": {
    "time_zone": "timezone",
    "iso_code": "iso3166code",
    "englishmotto": "national_motto",
    "motto": "national_motto",
    "admin_center": "capital",
    "image_map_caption": "map_caption",
    "official_language": "official_languages",
    "national_language": "official_languages",
    "languages_type": "languages_type",
    "currency_code": "currency_code"
  },

  "_comment_field_filter_patterns": "Regex patterns; any field whose canonical name matches is dropped before tree construction.",
  "field_filter_patterns": [
    "^image_",
    "^flag_",
    "^coa_",
    "^map_",
    "^alt_",
    "^title_",
    ".*_ref$",
    "^rowclass",
    "^label\\d*$",
    "^data\\d*$",
    "^bodystyle$",
    "^titlestyle$",
    "^subbox$",
    "^liststyle$",
    "^item_style$",
    "^area_label",
    "^area_data",
    "^area_footnote",
    "^area_link",
    "^today$",
    "^script-",
    "^url",
    "^archiveurl",
    "^archivedate",
    "^publisher$",
    "^journal$",
    "^volume$",
    "^pages$",
    "^date$",
    "^title$",
    "^last$"
  ],

  "_comment_category_layout": "Maps a canonical infobox field name (or composite group id) to its path in the country tree.",
  "category_layout": {
    "conventional_long_name":    "identity.long_name",
    "common_name":               "identity.common_name",
    "native_name":               "identity.native_name",
    "demonym":                   "identity.demonym",
    "national_motto":            "identity.motto",
    "national_anthem":           "identity.anthem",

    "capital":                   "geography.capital",
    "largest_city":              "geography.largest_city",
    "coordinates":               "geography.coordinates",
    "area_km2":                  "geography.area.km2",
    "area_rank":                 "geography.area.rank",
    "percent_water":             "geography.area.water_pct",
    "timezone":                  "geography.timezone",
    "utc_offset":                "geography.utc_offset",
    "drives_on":                 "geography.drives_on",

    "government_type":           "government.type",
    "legislature":               "government.legislature",
    "upper_house":               "government.upper_house",
    "lower_house":               "government.lower_house",
    "@leaders":                  "government.leaders",

    "GDP_PPP":                   "economy.gdp_ppp.value",
    "GDP_PPP_year":              "economy.gdp_ppp.year",
    "GDP_PPP_per_capita":        "economy.gdp_ppp.per_capita",
    "GDP_PPP_rank":              "economy.gdp_ppp.rank",
    "GDP_nominal":               "economy.gdp_nominal.value",
    "GDP_nominal_year":          "economy.gdp_nominal.year",
    "GDP_nominal_per_capita":    "economy.gdp_nominal.per_capita",
    "GDP_nominal_rank":          "economy.gdp_nominal.rank",
    "Gini":                      "economy.gini.value",
    "Gini_year":                 "economy.gini.year",
    "Gini_change":               "economy.gini.change",
    "HDI":                       "economy.hdi.value",
    "HDI_year":                  "economy.hdi.year",
    "HDI_rank":                  "economy.hdi.rank",
    "HDI_change":                "economy.hdi.change",
    "currency":                  "economy.currency",

    "population_estimate":       "demographics.population.estimate",
    "population_estimate_year":  "demographics.population.estimate_year",
    "population_census":         "demographics.population.census",
    "population_census_year":    "demographics.population.census_year",
    "population_density_km2":    "demographics.population.density",
    "official_languages":        "demographics.languages",
    "languages":                 "demographics.languages",
    "religion":                  "demographics.religion",
    "religion_year":             "demographics.religion_year",
    "ethnic_groups":             "demographics.ethnic_groups",
    "ethnic_groups_year":        "demographics.ethnic_groups_year",

    "@established":              "history.established",

    "iso3166code":                "codes.iso3166",
    "cctld":                      "codes.cctld",
    "calling_code":               "codes.calling_code"
  },

  "_comment_serial_groups": "Composite group rules. Each rule captures repeated numbered fields and emits a single composite list. Emits a synthetic field named '@<group_id>' which is then placed via category_layout.",
  "serial_groups": {
    "@leaders": {
      "patterns": {
        "title": "^leader_title(\\d+)$",
        "name":  "^leader_name(\\d+)$"
      },
      "child_label": "leader",
      "index_key": "index"
    },
    "@established": {
      "patterns": {
        "event": "^established_event(\\d+)$",
        "date":  "^established_date(\\d+)$"
      },
      "child_label": "event",
      "index_key": "index"
    }
  },

  "_comment_field_types": "Explicit type override per canonical field. If absent, type is inferred from the value. Values: number, percent, year, date, currency, coordinates, wikilink, text, distribution:<taxonomy>",
  "field_types": {
    "area_km2":                  "number",
    "percent_water":             "percent",
    "population_estimate":       "number",
    "population_estimate_year":  "year",
    "population_census":         "number",

# =============================================================================
# MongoDB (docker-compose.yml)
# =============================================================================
# Root admin credentials — used to initialize the Mongo container.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# Application database name (created on first connection).
MONGO_DB_NAME=idpa

# Connection URI used by the Python client. Host is "localhost" because the
# container publishes port 27017 to 127.0.0.1 only.
MONGO_URI=mongodb://root:changeme@localhost:27017/?authSource=admin

# Collection used for country documents.
MONGO_COUNTRIES_COLLECTION=countries

# =============================================================================
# mongo-express admin UI (http://localhost:8081)
# =============================================================================
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin

# =============================================================================
# LLM API keys (agent extension — optional, fill in later)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
